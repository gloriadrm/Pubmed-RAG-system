# Solo son obligatorias las variables del proveedor seleccionado en
# LLM_PROVIDER — no hace falta rellenar las de los otros dos proveedores.

NCBI_API_KEY=tu_clave_ncbi

# Proveedor LLM activo: openai | gemini | ollama
LLM_PROVIDER=openai

# --- OpenAI (requerido si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Gemini (requerido si LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY es la variable recomendada. GOOGLE_API_KEY se acepta como
# alias heredado (prioridad: GEMINI_API_KEY primero) para proyectos que ya
# la tuvieran configurada.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (requerido si LLM_PROVIDER=ollama; no necesita API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
